# ── OrionSoft Agentic RAG Platform - Backend Environment Variables ──
# Copy to .env and configure values for your environment.

# ── Server & Runtime ───────────────────────────────────────────
FLASK_ENV=
FLASK_DEBUG=
PORT=
APP_VERSION=
ALLOWED_ORIGINS=

# ── API Key & Authentication ───────────────────────────────────
RAG_API_KEY=
AUTH_JWT_SECRET=
AUTH_INTROSPECTION_URL=

# ── Database Persistence ───────────────────────────────────────
# Supabase PostgreSQL session pooler connection string.
# When unset or empty, the backend automatically uses local SQLite.
DATABASE_URL=
RAG_DB_PATH=

# ── Neural Generation & LLM Providers ──────────────────────────
# At least one provider key is recommended.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
LOCAL_LLM_BASE_URL=
LOCAL_EMBEDDING_BASE_URL=

# ── Google Drive Integration (OAuth 2.0) ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Rate Limiting & Proxies ────────────────────────────────────
RATE_LIMIT_ENABLED=
RATE_LIMIT_DEFAULT=
RATE_LIMIT_QUERY=
RATE_LIMIT_STORAGE_URI=
TRUSTED_PROXY_COUNT=

# ── Observability & Monitoring ─────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
WEB_CONCURRENCY=
GUNICORN_THREADS=
